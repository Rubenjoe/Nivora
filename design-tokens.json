        "colorSpace": "srgb",
        "components": [0.663, 0.678, 0.722],
        "hex": "#a9adb8"
      }
    },
    "secondary-light": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.337, 0.365, 0.408],
