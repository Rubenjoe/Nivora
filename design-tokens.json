    "expense": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.945, 0.529, 0.51],
        "hex": "#f18782"
      }
    },
    "expense-light": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.698, 0.227, 0.235],
        "hex": "#b23a3c"
      }
    },
    "analytics": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.533, 0.725, 0.925],
        "hex": "#88b9ec"
      }
    },
    "analytics-light": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.165, 0.373, 0.659],
        "hex": "#2a5fa8"
      }
    },
    "border": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.169, 0.188, 0.224],
        "hex": "#2b3039"
      }
    },
    "border-light": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.871, 0.847, 0.796],
        "hex": "#ded8cb"
      }
    }
  },
  "spacing": {
    "$type": "dimension",
    "sm": {
      "$value": {
        "value": 8,
        "unit": "px"
      }
    },
    "md": {
      "$value": {
        "value": 16,
        "unit": "px"
      }
    },
    "lg": {
      "$value": {
        "value": 24,
        "unit": "px"
      }
    },
    "xl": {
      "$value": {
        "value": 32,
        "unit": "px"
      }
    }
  },
  "rounded": {
    "$type": "dimension",
    "sm": {
      "$value": {
        "value": 8,
        "unit": "px"
      }
    },
    "md": {
      "$value": {
        "value": 10,
        "unit": "px"
      }
    },
    "lg": {
      "$value": {
        "value": 16,
        "unit": "px"
      }
    },
    "xl": {
      "$value": {
        "value": 20,
        "unit": "px"
      }
    }
  },
  "typography": {
    "display": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Ranade",
        "fontSize": {
          "value": 3.5,
          "unit": "rem"
        },
        "fontWeight": 400,
        "letterSpacing": {
          "value": -0.04,
          "unit": "em"
        }
      }
    },
    "body-md": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Ranade",
        "fontSize": {
          "value": 1,
          "unit": "rem"
        },
        "fontWeight": 400
      }
    },
    "label": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Ranade",
        "fontSize": {
          "value": 0.75,
          "unit": "rem"
        },
        "fontWeight": 600,
        "letterSpacing": {
          "value": 0.08,
          "unit": "em"
        }
      }
    }
  }
}
