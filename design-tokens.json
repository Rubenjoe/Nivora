        "colorSpace": "srgb",
        "components": [0.839, 0.718, 0.475],
        "hex": "#d6b779"
      }
    },
    "tertiary-light": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.533, 0.412, 0.165],
        "hex": "#88692a"
      }
    },
    "background": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.063, 0.071, 0.086],
        "hex": "#101216"
      }
    },
    "background-light": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.957, 0.945, 0.918],
        "hex": "#f4f1ea"
      }
    },
