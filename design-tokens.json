        "components": [0.663, 0.584, 1],
        "hex": "#a995ff"
      }
    },
    "primary-light": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.365, 0.29, 0.769],
        "hex": "#5d4ac4"
      }
    },
    "secondary": {
