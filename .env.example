# Safe placeholders only. Copy to .env.local and replace from the intended Supabase project.
APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<publishable-key>
# Runtime PostgreSQL URL; choose the Supabase connection mode appropriate to deployment.
DATABASE_URL=<runtime-pooler-url>
# Direct PostgreSQL URL for reviewed Drizzle migrations; server-only.
DIRECT_URL=<direct-or-session-pooler-url>
# Path to the Supabase root CA certificate (PEM) for TLS verification of the runtime connection.
# Download from the Supabase dashboard (Project settings → Database → connection → CA cert)
# and keep this file out of Git.
DATABASE_SSL_CA_PATH=<path-to-ca-certificate>
# Hosted deployments can supply the PEM contents directly instead of shipping a local certificate file.
DATABASE_SSL_CA_CERT=<supabase-root-ca-pem>
# Never add a Supabase service-role/secret key to a NEXT_PUBLIC_ variable.
