# Safe placeholders only. Copy to .env.local and replace with provisioned values.
APP_URL=http://localhost:3000
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://<your-appwrite-endpoint>/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=<your-appwrite-project-id>
# Server-only key. Registration/session creation may require users.write and sessions.write.
APPWRITE_API_KEY=<server-only-api-key>
# Runtime connection: use Appwrite's transaction pooler port (6432) in serverless deployments.
DATABASE_URL=postgresql://<user>:***@<host>:6432/<database>?sslmode=require
# Direct engine connection (5432) for Drizzle Kit migrations, not application requests.
DIRECT_URL=postgresql://<migration-user>:***@<host>:5432/<database>?sslmode=require
