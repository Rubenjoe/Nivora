# Safe placeholders only. Copy to .env.local and replace from the intended Supabase project.
APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<publishable-key>
# Runtime PostgreSQL URL; choose the Supabase connection mode appropriate to deployment.
DATABASE_URL=<runtime-pooler-url>
# Direct PostgreSQL URL for reviewed Drizzle migrations; server-only.
DIRECT_URL=<direct-or-session-pooler-url>
# Path to the Supabase root CA certificate (PEM) for TLS verification of the runtime connection.
# Download from the Supabase dashboard (Project settings → Database → connection → CA cert)
# and keep this file out of Git.
DATABASE_SSL_CA_PATH=<path-to-ca-certificate>
# Hosted deployments should supply the complete PEM contents directly; this takes precedence over the path.
DATABASE_SSL_CA=<supabase-root-ca-pem>
# Never add a Supabase service-role/secret key to a NEXT_PUBLIC_ variable.
# Optional, server-only. Lets "Delete my account" also remove the Supabase login.
# Without it, account deletion erases all data and signs out, but the login remains.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# End-to-end tests (Playwright). Use a TEST Supabase project and throwaway users only.
E2E_EMAIL=<test-user-email>
E2E_PASSWORD=<test-user-password>
# Destructive account-deletion test (optional, needs a disposable user):
# E2E_ALLOW_ACCOUNT_DELETE=1
# E2E_DELETE_EMAIL=<disposable-user-email>
# E2E_DELETE_PASSWORD=<disposable-user-password>
