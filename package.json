{
  "name": "nivora",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/**/*.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/db-migrate-preflight.ts && drizzle-kit migrate",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" *.mjs *.ts",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" *.mjs *.ts"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@tailwindcss/postcss": "^4.1.18",
    "clsx": "^2.1.1",
    "decimal.js": "^10.6.0",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^0.468.0",
    "motion": "^14.6.0",
    "next": "^16.4.2",
    "pg": "^8.23.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.0",
    "eslint-config-next": "^16.4.2",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
